@inherits LayoutComponentBase
@inject SpectrumDemoState State
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<AuthorizeView Roles="hr_platform_admin, admin, decider, hr">
    <Authorized>
        <div class="app-shell">
            <aside class="sidebar @(MobileMenuOpen ? "is-open" : null)">
                <div>
                    <div class="brand brand-light sidebar-brand"><span class="brand-mark"></span><span>Спектр</span></div>
                    <nav aria-label="Основная навигация">
                        <NavLink class="nav-item" href="/dashboard" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                            <SvgIcon Name="dashboard" /> <span>Дашборд</span>
                        </NavLink>
                        <NavLink class="nav-item" href="/candidates" @onclick="CloseMobileMenu">
                            <SvgIcon Name="users" /> <span>Реестр кандидатов</span>
                        </NavLink>
                        <NavLink class="nav-item" href="/interviews" @onclick="CloseMobileMenu">
                            <SvgIcon Name="calendar" /> <span>Реестр собесов</span>
                        </NavLink>
                        <NavLink class="nav-item" href="/candidates/new" @onclick="CloseMobileMenu">
                            <SvgIcon Name="plus" /> <span>Создать кандидата</span>
                        </NavLink>
                        <AuthorizeView Roles="decider" Context="deciderContext">
                            <NavLink class="nav-item" href="/decisions" @onclick="CloseMobileMenu">
                                <SvgIcon Name="checklist" /> <span>На согласовании</span><span class="nav-counter">@State.PendingCount</span>
                            </NavLink>
                        </AuthorizeView>
                        <AuthorizeView Roles="hr_platform_admin" Context="adminContext">
                            <div class="nav-divider">Админ</div>
                            <NavLink class="nav-item" href="/admin" @onclick="CloseMobileMenu">
                                <SvgIcon Name="shield" /> <span>Справочники</span>
                            </NavLink>
                        </AuthorizeView>
                    </nav>
                </div>

                <div class="sidebar-user">
                    <div class="user-summary">
                        <Initials Name="@(context.User.FindFirst(ClaimTypes.GivenName)?.Value ?? context.User.Identity?.Name)" Class="small inverse" />
                        <div>
                            <strong>@(context.User.FindFirst(ClaimTypes.GivenName)?.Value ?? context.User.Identity?.Name ?? "Пользователь") @(context.User.FindFirst(ClaimTypes.Surname)?.Value)</strong>
                            <span>@GetDisplayRole(context.User)</span>
                        </div>
                    </div>
                    <a href="/logout" class="logout-link" title="Выйти из системы">
                        <SvgIcon Name="logout" Size="16" /> 
                    </a>
                </div>
            </aside>

            @if (MobileMenuOpen)
            {
                <button class="menu-scrim" aria-label="Закрыть меню" @onclick="CloseMobileMenu"></button>
            }

            <main class="workspace">
                <header class="topbar">
                    <button class="menu-button" aria-label="Открыть меню" @onclick="() => MobileMenuOpen = !MobileMenuOpen"><SvgIcon Name="menu" /></button>
                    <div class="topbar-title">
                        <span class="eyebrow dark">Подбор и оценка</span>
                        <h1>@Title</h1>
                    </div>
                </header>

                @Body
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <main class="login-panel auth-required-page">
            <section class="login-card panel">
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <span class="eyebrow dark">Доступ закрыт</span>
                    <h2>Нет прав доступа</h2>
                    <p class="form-intro">Вы успешно авторизовались, но у вас нет нужных ролей.</p>
                    <a href="/logout" class="primary-button" style="text-decoration: none; text-align: center; display: block; margin-top: 1rem;">Сменить аккаунт</a>
                }
                else
                {
                    <span class="eyebrow dark">Авторизация</span>
                    <h2>Требуется вход</h2>
                    <p class="form-intro">Пожалуйста, войдите в систему.</p>
                    <a href="/login" class="primary-button" style="text-decoration: none; text-align: center; display: block; margin-top: 1rem;">Войти</a>
                }
            </section>
        </main>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool MobileMenuOpen;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var authState = await AuthState;
            State.SetUser(authState.User);
        }
    }

    private string Title => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0] switch
    {
        "" => "Спектр",
        "dashboard" => "Дашборд",
        "candidates" => "Реестр кандидатов",
        "interviews" => "Реестр собесов",
        "candidates/new" => "Создание кандидата",
        var route when route.Contains("/interviews/new", StringComparison.OrdinalIgnoreCase) => "Назначение собеседования",
        "decisions" => "На согласовании",
        "admin" => "Администрирование",
        var route when route.StartsWith("candidates/", StringComparison.OrdinalIgnoreCase) => "Карточка кандидата",
        var route when route.StartsWith("interviews/", StringComparison.OrdinalIgnoreCase) => "Протокол собеседования",
        _ => "Спектр"
    };

    private void CloseMobileMenu() => MobileMenuOpen = false;

    private string GetDisplayRole(System.Security.Claims.ClaimsPrincipal user)
    {
        var roles = user.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        
        if (roles.Contains("hr_platform_admin")) return "Админ";
        if (roles.Contains("decider")) return "Решала";
        if (roles.Contains("hr")) return "Отдел кадров";
            
        return "Без роли";
    }
}
