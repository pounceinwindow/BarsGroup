@page "/interviews/{InterviewId}/protocol"
@layout MainLayout
@inject SpectrumDemoState State
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IPdfDocumentService PdfService
@inject IMediator Mediator

@using Application.Exceptions
@using Application.Interview.Commands.CancelInterview
@using Application.Interview.Commands.SubmitProtocol
@using Application.Interview.Commands.SubmitVerdict
@using Application.Interview.DTO
@using Application.PdfDocuments
@using MediatR

<PageTitle>Спектр — протокол собеседования</PageTitle>

@if (Interview is null || Candidate is null)
{
    <section class="page-content">
        <div class="empty-state panel"><strong>Протокол не найден</strong><span>Вернитесь в реестр собеседований и выберите существующий собес.</span><button class="text-button" @onclick='() => Navigation.NavigateTo("/interviews")'>К реестру</button></div>
    </section>
}
else
{
    <section class="page-content protocol-page">
        <div class="protocol-actions">
            <button class="back-button" @onclick='() => Navigation.NavigateTo($"/candidates/{Candidate.Id}")'><SvgIcon Name="back" Size="16" /> К карточке кандидата</button>
            <div class="protocol-action-buttons">
                <button class="secondary-button" @onclick="Print"><SvgIcon Name="print" Size="15" /> Печать</button>
                <button class="secondary-button" @onclick="DownloadPdf" disabled="@(IsPdfDownloading || IsLetterDownloading)"><SvgIcon Name="download" Size="15" /> @(IsPdfDownloading ? "Формирование…" : "Скачать PDF")</button>
                @if (Interview.Decision == "Принять")
                {
                    <button class="secondary-button" @onclick="DownloadLetter" disabled="@(IsPdfDownloading || IsLetterDownloading)"><SvgIcon Name="download" Size="15" /> @(IsLetterDownloading ? "Формирование…" : "Скачать письмо")</button>
                }
            </div>
        </div>

        <article class="protocol-sheet">
            <header class="protocol-header">
                <div class="protocol-seal"><span>СП</span><small>HR · 2026</small></div>
                <div><span class="eyebrow dark">Протокол собеседования</span><h2>@Interview.Vacancy</h2></div>
                <StatusBadge Status="@Interview.Status" />
            </header>

            <div class="protocol-meta">
                <div><small>Кандидат</small><strong>@Candidate.Name</strong></div>
                <div><small>Дата и время (UTC)</small><strong class="mono">@SpectrumDemoState.DisplayDate(Interview.Date) · @Interview.Time</strong></div>
                <div><small>HR</small><strong>@Interview.Hr</strong></div>
                @if (Interview.Decision is not null)
                {
                    <div><small>Согласующий</small><strong>@Interview.Approver</strong></div>
                }
            </div>

            <section class="matrix-section">
                <div class="section-heading compact"><span class="eyebrow dark">Шкала 1–5</span><h3>Матрица компетенций</h3></div>
                <div class="matrix-list">
                    @foreach (var competency in State.CompetenciesForInterview(Interview))
                    {
                        var score = Score(competency);
                        <div class="matrix-row">
                            <span>@competency.Name</span>
                            <DotScale Value="@score" Editable="@State.CanEditProtocol(Interview)" OnChange="@(newScore => SetScore(competency, newScore))" />
                            <strong class="mono">@(score == 0 ? "—" : score)/5</strong>
                            @* [TODO: Артур] - форма для комментария по оценке *@
                        </div>
                    }
                </div>
            </section>

            <section class="comment-section">
                <label for="comment">Комментарий по итогам</label>
                <textarea id="comment" @bind="Interview.Comment" @bind:event="oninput" disabled="@(!State.CanEditProtocol(Interview))" placeholder="Ключевые наблюдения по итогам собеседования"></textarea>
            </section>

            @if (State.CanRecordVerdict(Interview) || Interview.Decision is not null)
            {
                <section class="decision-section">
                    <div class="section-heading compact"><span class="eyebrow dark">Итог интервью</span><h3>Решение</h3></div>
                    @if (State.CanCancelInterview(Interview))
                    {
                        <div class="protocol-decision-actions">
                            @if (State.CanEditProtocol(Interview))
                            {
                                <button class="secondary-button save-protocol-button" @onclick="SaveProtocol" disabled="@(IsSaving || IsCanceling)"><SvgIcon Name="check" Size="14" /> @(IsSaving ? "Сохранение…" : "Сохранить протокол")</button>
                            }
                            <button class="secondary-button reject cancel-interview-button" type="button" @onclick="CancelInterview" disabled="@(IsSaving || IsCanceling)">@(IsCanceling ? "Отмена…" : "Отменить собеседование")</button>
                        </div>
                    }
                    else if (State.CanEditProtocol(Interview))
                    {
                        <div class="protocol-decision-actions">
                            <button class="secondary-button save-protocol-button" @onclick="SaveProtocol" disabled="@(IsSaving || IsCanceling)"><SvgIcon Name="check" Size="14" /> @(IsSaving ? "Сохранение…" : "Сохранить протокол")</button>
                        </div>
                    }
                    <div class="decision-options">
                        @foreach (var option in State.DecisionOptions)
                        {
                            var isActive = State.CanRecordVerdict(Interview)
                                ? SelectedDecision == option
                                : Interview.Decision == option;
                            <button class="decision-button @DecisionClass(option) @(isActive ? "is-active" : null)"
                                    disabled="@(!State.CanRecordVerdict(Interview))"
                                    @onclick="() => SelectDecision(option)">
                                @if (isActive) { <SvgIcon Name="check" Size="14" /> } @option
                            </button>
                        }
                    </div>
                    @if (!State.CanRecordVerdict(Interview) && !string.IsNullOrWhiteSpace(Interview.VerdictComment))
                    {
                        <div class="comment-section verdict-comment">
                            <label for="verdict-comment-readonly">Комментарий решалы</label>
                            <textarea id="verdict-comment-readonly" readonly disabled>@Interview.VerdictComment</textarea>
                        </div>
                    }
                    @if (State.CanRecordVerdict(Interview))
                    {
                        <div class="comment-section verdict-comment">
                            <label for="verdict-comment">Комментарий решалы</label>
                            <textarea id="verdict-comment" @bind="VerdictComment" @bind:event="oninput" placeholder="Необязательный комментарий к решению"></textarea>
                        </div>
                        <div class="protocol-decision-actions">
                            <button class="secondary-button save-protocol-button"
                                    @onclick="SubmitVerdict"
                                    disabled="@(IsSubmittingVerdict || string.IsNullOrEmpty(SelectedDecision))">
                                <SvgIcon Name="check" Size="14" /> @(IsSubmittingVerdict ? "Сохранение…" : "Подтвердить решение")
                            </button>
                        </div>
                    }
                </section>
            }
            else if (State.CanCancelInterview(Interview) || State.CanEditProtocol(Interview))
            {
                <section class="decision-section">
                    <div class="section-heading compact"><span class="eyebrow dark">Итог интервью</span><h3>Решение</h3></div>
                    @if (State.CanCancelInterview(Interview))
                    {
                        <div class="protocol-decision-actions">
                            @if (State.CanEditProtocol(Interview))
                            {
                                <button class="secondary-button save-protocol-button" @onclick="SaveProtocol" disabled="@(IsSaving || IsCanceling)"><SvgIcon Name="check" Size="14" /> @(IsSaving ? "Сохранение…" : "Сохранить протокол")</button>
                            }
                            <button class="secondary-button reject cancel-interview-button" type="button" @onclick="CancelInterview" disabled="@(IsSaving || IsCanceling)">@(IsCanceling ? "Отмена…" : "Отменить собеседование")</button>
                        </div>
                    }
                    else
                    {
                        <div class="protocol-decision-actions">
                            <button class="secondary-button save-protocol-button" @onclick="SaveProtocol" disabled="@(IsSaving || IsCanceling)"><SvgIcon Name="check" Size="14" /> @(IsSaving ? "Сохранение…" : "Сохранить протокол")</button>
                        </div>
                    }
                </section>
            }

            <footer class="signature-grid">
                <span>HR: @Interview.Hr <i></i></span>
                @if (Interview.Decision is not null)
                {
                    <span>Согласующий: @Interview.Approver <i></i></span>
                }
            </footer>
        </article>
    </section>

    @if (!string.IsNullOrEmpty(ToastMessage))
    {
        <div class="toast" role="status"><SvgIcon Name="check" Size="16" /> @ToastMessage</div>
    }
}

@code {
    [Parameter] public string InterviewId { get; set; } = string.Empty;

    private bool IsPdfDownloading;
    private bool IsLetterDownloading;
    private bool IsSaving;
    private bool IsCanceling;
    private bool IsSubmittingVerdict;
    private string? ToastMessage;
    private string? SelectedDecision;
    private string VerdictComment = string.Empty;

    private DemoInterview? Interview => State.GetInterview(InterviewId);
    private DemoCandidate? Candidate => Interview is null ? null : State.GetCandidateForInterview(Interview);

    private int Score(DemoCompetency competency)
    {
        if (Interview is null)
            return 0;

        return Interview.Scores.TryGetValue(competency.Id, out var score) ? score : 0;
    }

    private void SetScore(DemoCompetency competency, int score)
    {
        if (Interview is not null && State.CanEditProtocol(Interview))
            State.SetScore(Interview, competency.Id, score);
    }

    private async Task SaveProtocol()
    {
        if (Interview is null || !State.CanEditProtocol(Interview))
            return;

        IsSaving = true;
        try
        {
            var scores = State.CompetenciesForInterview(Interview)
                .Select(competency => new CompetencyScoreInput(
                    competency.Id,
                    Score(competency),
                    Interview.ScoreComments.GetValueOrDefault(competency.Id)))
                .ToList();

            await Mediator.Send(new SubmitProtocolCommand(
                Interview.DbId,
                State.CurrentUserId,
                string.IsNullOrWhiteSpace(Interview.Comment) ? null : Interview.Comment.Trim(),
                scores));

            State.Reload();
            await ShowToast("Протокол сохранён");
        }
        catch (NotFoundException ex)
        {
            await ShowToast(ex.Message);
        }
        catch (ConflictException ex)
        {
            await ShowToast(ex.Message);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task CancelInterview()
    {
        if (Interview is null || !State.CanCancelInterview(Interview))
            return;

        IsCanceling = true;
        try
        {
            await Mediator.Send(new CancelInterviewCommand(Interview.DbId, State.CurrentUserId));
            State.Reload();
            await ShowToast("Собеседование отменено");
        }
        catch (NotFoundException ex)
        {
            await ShowToast(ex.Message);
        }
        catch (ConflictException ex)
        {
            await ShowToast(ex.Message);
        }
        finally
        {
            IsCanceling = false;
        }
    }

    private void SelectDecision(string decision)
    {
        if (Interview is null || !State.CanRecordVerdict(Interview))
            return;

        SelectedDecision = decision;
    }

    private async Task SubmitVerdict()
    {
        if (Interview is null || !State.CanRecordVerdict(Interview) || string.IsNullOrEmpty(SelectedDecision))
            return;

        IsSubmittingVerdict = true;
        try
        {
            var decisionLabel = SelectedDecision;
            await Mediator.Send(new SubmitVerdictCommand(
                Interview.DbId,
                State.CurrentUserId,
                SpectrumDemoState.ToDeciderVerdict(SelectedDecision),
                string.IsNullOrWhiteSpace(VerdictComment) ? null : VerdictComment.Trim()));

            State.Reload();
            SelectedDecision = null;
            VerdictComment = string.Empty;
            await ShowToast($"Решение «{decisionLabel}» сохранено");
        }
        catch (NotFoundException ex)
        {
            await ShowToast(ex.Message);
        }
        catch (ConflictException ex)
        {
            await ShowToast(ex.Message);
        }
        finally
        {
            IsSubmittingVerdict = false;
        }
    }

    private async Task Print() => await JS.InvokeVoidAsync("print");

    private async Task DownloadPdf()
    {
        if (Candidate is null || Interview is null || IsPdfDownloading)
            return;

        IsPdfDownloading = true;
        try
        {
            var dateUtc = SpectrumDemoState.AsUtc(Interview.Date);
            if (TimeSpan.TryParse(Interview.Time, CultureInfo.InvariantCulture, out var time))
                dateUtc = dateUtc.Date.Add(time);

            var model = new InterviewProtocolModel(
                Candidate.Name,
                Interview.Vacancy,
                dateUtc,
                Interview.Hr,
                string.IsNullOrWhiteSpace(Interview.Approver) ? null : Interview.Approver,
                Interview.Status,
                string.IsNullOrWhiteSpace(Interview.Comment) ? null : Interview.Comment.Trim(),
                Interview.Decision,
                string.IsNullOrWhiteSpace(Interview.VerdictComment) ? null : Interview.VerdictComment.Trim(),
                State.CompetenciesForInterview(Interview).Select(competency => new CompetencyScoreModel(
                    competency.Name,
                    Score(competency),
                    Interview.ScoreComments.GetValueOrDefault(competency.Id))).ToList());

            var pdf = PdfService.CreateInterviewProtocol(model);
            await using var stream = new MemoryStream(pdf, writable: false);
            using var streamReference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync(
                "downloadFileFromStream",
                $"protocol-{Candidate.Id:0000}-{Interview.Id}.pdf",
                streamReference);
            await ShowToast("PDF-протокол сформирован");
        }
        catch
        {
            await ShowToast("Не удалось сформировать PDF");
        }
        finally
        {
            IsPdfDownloading = false;
        }
    }

    private async Task DownloadLetter()
    {
        if (Candidate is null || Interview is null || Interview.Decision != "Принять" || IsLetterDownloading)
            return;

        IsLetterDownloading = true;
        try
        {
            var pdf = PdfService.CreateApplicationLetter(
                new ApplicationLetterModel(Candidate.Name, Interview.Vacancy),
                LetterType.Invitation);
            await using var stream = new MemoryStream(pdf, writable: false);
            using var streamReference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync(
                "downloadFileFromStream",
                $"letter-{Candidate.Id:0000}-{Interview.Id}.pdf",
                streamReference);
            await ShowToast("Письмо сформировано");
        }
        catch
        {
            await ShowToast("Не удалось сформировать письмо");
        }
        finally
        {
            IsLetterDownloading = false;
        }
    }

    private async Task ShowToast(string message)
    {
        ToastMessage = message;
        StateHasChanged();
        await Task.Delay(2200);
        ToastMessage = null;
    }

    private static string DecisionClass(string decision) => decision switch
    {
        "Принять" => "accept",
        "Следующий этап" => "next",
        "Резерв" => "reserve",
        _ => "reject"
    };
}
