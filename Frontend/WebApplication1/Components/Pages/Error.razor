@page "/Error"

<PageTitle>Ошибка — Спектр</PageTitle>

<main class="login-panel" style="min-height: 100vh">
    <section class="login-card">
        <div class="brand"><span class="brand-mark"></span><span>Спектр</span></div>
        <span class="eyebrow dark" style="margin-top: 48px">Системное сообщение</span>
        <h2>Не удалось открыть страницу</h2>
