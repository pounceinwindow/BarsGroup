@page "/candidates"
@page "/decisions"
@layout MainLayout

@using Application.Interview.DTO
@using MediatR
@using Application.Candidate.Query.GetFilteredCandidates
@using Domain.Enums
@using Application.Candidate.DTO

@inject SpectrumDemoState State
@inject NavigationManager Navigation
@inject IMediator _mediator

<section class="page-content registry-page">
    <div class="page-heading-row">
        <button class="primary-button action-button" @onclick='() => Navigation.NavigateTo("/candidates/new")'>
            <SvgIcon Name="plus" Size="15" /> Новый кандидат
        </button>
    </div>

    <div class="registry-toolbar">
        <div class="filter-group">
            <label>
                Поиск
                <input class="filter-input" @bind="Filters.Search"
                       @bind:after="ApplyFilters" placeholder="ФИО" />
            </label>
            <label>
                Статус
                <select @bind="Filters.Status" @bind:after="ApplyFilters">
                    @foreach (var status in Enum.GetValues<CandidateStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>

            <button class="secondary-button" @onclick="ResetFilters">Сбросить фильтры</button>
        </div>

        @* Блок пагинации *@
        @if (TotalPages > 1)
        {
            <div class="pagination" style="margin-top: 20px; display: flex; gap: 10px; align-items: center; justify-content: center;">
                <button class="secondary-button" disabled="@(Filters.Page == 1)" @onclick="() => GoToPage(Filters.Page - 1)">← Назад</button>
                <span>Страница @Filters.Page из @TotalPages</span>
                <button class="secondary-button" disabled="@(Filters.Page == TotalPages)" @onclick="() => GoToPage(Filters.Page + 1)">Вперед →</button>
            </div>
        }

        <span class="result-count">Найдено <strong>@TotalCount</strong></span>
    </div>

    

    <div class="registry-table panel">
        <div class="registry-head"><span>Кандидат</span><span>Статус</span><span>Город</span> <span>Почта</span></div>
        @if (Candidates.Count == 0)
        {
            <div class="empty-state">
                <strong>Кандидаты не найдены</strong>
                <span>Измените запрос или сбросьте фильтры.</span>
            </div>
        }
        @foreach (var candidate in Candidates)
        {
            <button class="registry-row" @onclick='() => Navigation.NavigateTo($"/candidates/{candidate.Id}")'>
                <span class="candidate-cell"><Initials Name="@candidate.FullName" /><span><strong>@candidate.FullName</strong><small>@candidate.City · @candidate.Email</small></span></span>
                <span data-label="Статус"><StatusBadge Status="@candidate.CandidateStatus.ToString()" /></span>
                <span data-label="Город">@candidate.City</span>
                <span data-label="Почта">@candidate.Email</span>
            </button>
        }
    </div>
</section>

@code {
    private List<CandidateListUnit> Candidates = new();
    private int TotalCount = 0;

    // Вычисляемое свойство для общего количества страниц
    private int TotalPages => TotalCount == 0 ? 0 : (int)Math.Ceiling(TotalCount / (double)Filters.PageSize);

    // Инициализируем фильтры с дефолтными значениями страницы
    private readonly CandidateFilters Filters = new() { Page = 1, PageSize = 10 };

    protected override async Task OnInitializedAsync()
    {
        await LoadCandidates();
    }

    private async Task LoadCandidates()
    {
        var result = await _mediator.Send(new GetFilteredCandidatesQuery(Filters));
        Candidates = result.Items;
        TotalCount = result.TotalCount;
    }

    private async Task ApplyFilters()
    {
        Filters.Page = 1; // При изменении фильтров всегда возвращаемся на первую страницу
        await LoadCandidates();
    }

    private async Task ResetFilters()
    {
        Filters.Search = string.Empty;
        Filters.Status = CandidateStatus.All;
        Filters.Page = 1;
        await LoadCandidates();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        Filters.Page = page;
        await LoadCandidates();
    }
}