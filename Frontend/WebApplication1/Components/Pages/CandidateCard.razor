@page "/candidates/{CandidateId:int}"
@layout MainLayout
@inject SpectrumDemoState State
@inject NavigationManager Navigation
@inject IMediator Mediator

@using Application.Exceptions
@using Application.Interview.DTO
@using Application.Interview.Queries.GetCandidate
@using MediatR

<PageTitle>Спектр — карточка кандидата</PageTitle>

@if (!_loaded)
{
    <section class="page-content">
        <p class="muted">Загрузка…</p>
    </section>
}
else if (Candidate is null)
{
    <section class="page-content">
        <div class="empty-state panel"><strong>Кандидат не найден</strong><span>Вернитесь в реестр и выберите существующую карточку.</span><button class="text-button" @onclick='() => Navigation.NavigateTo("/candidates")'>К реестру</button></div>
    </section>
}
else
{
    <section class="page-content candidate-page">
        <button class="back-button" @onclick='() => Navigation.NavigateTo("/candidates")'><SvgIcon Name="back" Size="16" /> К реестру</button>

        <article class="candidate-hero panel">
            <div class="candidate-heading">
                <Initials Name="@Candidate.FullName" Class="large" />
                <div><span class="eyebrow dark">Карточка кандидата</span><h2>@Candidate.FullName</h2><StatusBadge Status="@SpectrumDemoState.CandidateDisplayStatus(Candidate.Status)" /></div>
                <span class="candidate-number">№ @Candidate.Id.ToString("0000")</span>
            </div>
            <div class="candidate-facts">
                <div><SvgIcon Name="phone" /><span><small>Телефон</small>@Candidate.Phone</span></div>
                <div><SvgIcon Name="mail" /><span><small>Электронная почта</small>@Candidate.Email</span></div>
                <div><SvgIcon Name="pin" /><span><small>Город</small>@Candidate.City</span></div>
                <div><SvgIcon Name="send" /><span><small>Telegram</small>@(string.IsNullOrWhiteSpace(Candidate.Telegram) ? "—" : Candidate.Telegram)</span></div>
                <div class="wide"><SvgIcon Name="cap" /><span><small>Образование</small>@JoinItems(Candidate.Education)</span></div>
                <div class="wide"><SvgIcon Name="briefcase" /><span><small>Опыт</small>@JoinItems(Candidate.PreviousWork)</span></div>
            </div>
        </article>

        <div class="candidate-layout-grid">
            <section>
                <div class="section-heading"><span class="eyebrow dark">Отклики</span><h3>Отклики и собеседования</h3></div>
                @if (Candidate.ApplicationProcesses.Count == 0)
                {
                    <div class="empty-state panel"><strong>Откликов пока нет</strong><span>Назначьте собеседование для кандидата.</span><button class="secondary-button" type="button" @onclick="ScheduleNewProcess">Назначить собес</button></div>
                }
                @foreach (var process in Candidate.ApplicationProcesses)
                {
                    <div class="section-heading compact"><h4>@process.VacancyName</h4></div>
                    <div class="response-list">
                        @foreach (var interview in process.Interviews)
                        {
                            <article class="response-card panel">
                                <div class="response-date"><strong>@SpectrumDemoState.AsUtc(interview.Date).Day.ToString("00")</strong><span>@SpectrumDemoState.MonthName(SpectrumDemoState.AsUtc(interview.Date))</span><small>@SpectrumDemoState.AsUtc(interview.Date).Year</small></div>
                                <div class="response-main">
                                    <h4>@process.VacancyName</h4>
                                    <span><SvgIcon Name="calendar" Size="14" /> @SpectrumDemoState.DisplayDate(interview.Date) · @SpectrumDemoState.FormatTimeUtc(interview.Date) (UTC)</span>
                                </div>
                                <StatusBadge Status="@SpectrumDemoState.InterviewDisplayStatus(interview)" />
                                <button class="secondary-button" @onclick='() => Navigation.NavigateTo($"/interviews/{interview.Id}/protocol")'>Открыть протокол</button>
                                @if (SpectrumDemoState.CanScheduleInterviewInProcess(process, interview))
                                {
                                    <button class="secondary-button" type="button" @onclick="() => ScheduleNextStage(process)">Назначить собес</button>
                                }
                            </article>
                        }
                    </div>
                }
            </section>

            <aside class="panel side-card">
                <div class="panel-heading"><div><span class="eyebrow dark">Навыки</span><h3>Ключевые теги</h3></div></div>
                <div class="pill-list">
                    @foreach (var skill in Candidate.Skills)
                    {
                        <span>@skill</span>
                    }
                </div>
                <button class="secondary-button full-width" type="button" @onclick="ScheduleNewProcess"><SvgIcon Name="plus" Size="15" /> Назначить собес</button>
            </aside>
        </div>
    </section>
}

@code {
    [Parameter] public int CandidateId { get; set; }

    private CandidateResponse? Candidate;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        State.Reload();

        try
        {
            Candidate = await Mediator.Send(new GetCandidateQuery(CandidateId));
        }
        catch (NotFoundException)
        {
            Candidate = null;
        }

        _loaded = true;
    }

    private static string JoinItems(string[]? items) =>
        items is null || items.Length == 0 ? "—" : string.Join("; ", items);

    private void ScheduleNewProcess() =>
        Navigation.NavigateTo($"/candidates/{CandidateId}/interviews/new");

    private void ScheduleNextStage(ApplicationProcessResponse process) =>
        Navigation.NavigateTo($"/candidates/{CandidateId}/interviews/new?processId={process.ProcessId}&vacancyId={process.VacancyId}");
}
