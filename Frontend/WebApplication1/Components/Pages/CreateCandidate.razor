@page "/candidates/new"
@layout MainLayout

@using Application.Interview.Commands.CreateCandidate
@using MediatR
@using Microsoft.AspNetCore.Components.Forms

@inject SpectrumDemoState State
@inject NavigationManager Navigation
@inject IMediator _mediator

<PageTitle>Спектр — создание кандидата</PageTitle>

<section class="page-content form-page">
    <button class="back-button" @onclick='() => Navigation.NavigateTo("/candidates")'><SvgIcon Name="back" Size="16" /> К реестру</button>

    <EditForm class="form-layout"
        FormName="CreateCandidate"
        Model="Form"
        OnValidSubmit="Create">

        <article class="panel form-card">
            <div class="panel-heading"><div><span class="eyebrow dark">Новая карточка</span><h3>Создание кандидата</h3></div></div>

            <DataAnnotationsValidator/>
            <WebApplication1.Components.Shared.CustomValidation @ref="_customValidation" />

            <div class="form-grid">
                <label class="span-2">ФИО <ValidationMessage For="() => Form.FullName" /><input @bind="Form.FullName" @bind:event="oninput" placeholder="Иванов Иван Иванович" /></label>
                <label>Город <ValidationMessage For="() => Form.City" /><input @bind="Form.City" @bind:event="oninput" /></label>
                <label>Телефон <ValidationMessage For="() => Form.Phone" /><input @bind="Form.Phone" @bind:event="oninput" placeholder="+7 900 000-00-00" /></label>
                <label>Email <ValidationMessage For="() => Form.Email" /><input @bind="Form.Email" @bind:event="oninput" placeholder="candidate@mail.ru" /></label>
                <label>Telegram <ValidationMessage For="() => Form.Telegram" /><input @bind="Form.Telegram" @bind:event="oninput" placeholder="@@candidate" /></label>
                <label class="span-2">Образование <ValidationMessage For="() => Form.Education" /><textarea @bind="Form.Education" @bind:event="oninput" placeholder="Вуз, направление, год"></textarea></label>
                <label class="span-2">Предыдущий опыт <ValidationMessage For="() => Form.Experience" /><textarea @bind="Form.Experience" @bind:event="oninput" placeholder="Опишите релевантный опыт"></textarea></label>
                <label class="span-2">Навыки <ValidationMessage For="() => Form.Skills" /><textarea @bind="Form.Skills" @bind:event="oninput" placeholder="C#, ASP.NET Core, SQL" /></label>
            </div>

            <div class="form-actions">
                <button class="secondary-button" @onclick='() => Navigation.NavigateTo("/candidates")'>Отмена</button>
                <button type="submit" class="primary-button action-button">Создать кандидата</button>
            </div>
        </article>

        <aside class="panel side-card">
            <span class="eyebrow dark">Что появится</span>
            <h3>Карточка кандидата</h3>
            <p class="muted">После сохранения кандидат попадёт в реестр, а если выбрана вакансия — у него появится первичный отклик.</p>
        </aside>
    </EditForm>
</section>

@code {
    private CandidateForm Form { get; } = new();

    private WebApplication1.Components.Shared.CustomValidation? _customValidation;

    protected override void OnInitialized()
    {
        Form.Vacancy = State.VacancyTitles.FirstOrDefault() ?? string.Empty;
    }

    private async Task Create()
    {
        _customValidation?.ClearErrors();

        try
        {
            var command = new CreateCandidateCommand
            (
                Form.FullName,
                Form.Phone,
                Form.Email,
                string.IsNullOrWhiteSpace(Form.Telegram) ? null : Form.Telegram,
                Form.City,
                Form.Education.Split('\n', StringSplitOptions.RemoveEmptyEntries),
                Form.Experience.Split('\n', StringSplitOptions.RemoveEmptyEntries),
                Form.Skills.Split('\n', StringSplitOptions.RemoveEmptyEntries)
            );

            var candidateId = await _mediator.Send(command);

            Navigation.NavigateTo($"/candidates/{candidateId}");
        }
        catch (FluentValidation.ValidationException ex)
        {
            var errors = new Dictionary<string, IEnumerable<string>>();
            foreach (var error in ex.Errors)
            {
                var propName = error.PropertyName;
                // Map FluentValidation collection names to UI properties
                if (propName.StartsWith("PreviousWork")) propName = "Experience";
                else if (propName.StartsWith("Education")) propName = "Education";
                else if (propName.StartsWith("Skills")) propName = "Skills";

                if (!errors.ContainsKey(propName))
                {
                    errors[propName] = new List<string>();
                }
                ((List<string>)errors[propName]).Add(error.ErrorMessage);
            }
            _customValidation?.DisplayErrors(errors);
        }
    }
}
