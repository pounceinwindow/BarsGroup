@page "/candidates/new"
@layout MainLayout

@using Application.Interview.Commands.CreateCandidate
@using MediatR

@inject SpectrumDemoState State
@inject NavigationManager Navigation
@inject IMediator _mediator

<PageTitle>Спектр — создание кандидата</PageTitle>

<section class="page-content form-page">
    <button class="back-button" @onclick='() => Navigation.NavigateTo("/candidates")'><SvgIcon Name="back" Size="16" /> К реестру</button>

    <div class="form-layout">
        <article class="panel form-card">
            <div class="panel-heading"><div><span class="eyebrow dark">Новая карточка</span><h3>Создание кандидата</h3></div></div>

            <div class="form-grid">
                <label class="span-2">ФИО<input @bind="Form.FullName" @bind:event="oninput" placeholder="Иванов Иван Иванович" /></label>
                <label>Город<input @bind="Form.City" @bind:event="oninput" /></label>
                <label>Телефон<input @bind="Form.Phone" @bind:event="oninput" placeholder="+7 900 000-00-00" /></label>
                <label>Email<input @bind="Form.Email" @bind:event="oninput" placeholder="candidate@mail.ru" /></label>
                <label>Telegram<input @bind="Form.Telegram" @bind:event="oninput" placeholder="@@candidate" /></label>
                <label class="span-2">Образование<textarea @bind="Form.Education" @bind:event="oninput" placeholder="Вуз, направление, год"></textarea></label>
                <label class="span-2">Предыдущий опыт<textarea @bind="Form.Experience" @bind:event="oninput" placeholder="Опишите релевантный опыт"></textarea></label>
                <label class="span-2">Навыки<input @bind="Form.Skills" @bind:event="oninput" placeholder="C#, ASP.NET Core, SQL" /></label>
                @* <label class="span-2">Первичный отклик<select @bind="Form.Vacancy"><option value="">Без отклика</option>@foreach (var vacancy in State.VacancyTitles) { <option value="@vacancy">@vacancy</option> }</select></label> *@
            </div>

            <div class="form-actions">
                <button class="secondary-button" @onclick='() => Navigation.NavigateTo("/candidates")'>Отмена</button>
                <button class="primary-button action-button" @onclick="Create">Создать кандидата</button>
            </div>
        </article>

        <aside class="panel side-card">
            <span class="eyebrow dark">Что появится</span>
            <h3>Карточка кандидата</h3>
            <p class="muted">После сохранения кандидат попадёт в реестр, а если выбрана вакансия — у него появится первичный отклик.</p>
        </aside>
    </div>
</section>

@code {
    private CandidateForm Form { get; } = new();
    private CreateCandidateCommand CandidateCommand;

    protected override void OnInitialized()
    {
        Form.Vacancy = State.VacancyTitles.FirstOrDefault() ?? string.Empty;
    }

    private async Task Create()
    {
        var command = new CreateCandidateCommand
        (
            Form.FullName,
            Form.Phone,
            Form.Email,
            string.IsNullOrWhiteSpace(Form.Telegram) ? null : Form.Telegram,
            Form.City,
            Form.Education.Split('\n'),
            Form.Experience.Split('\n'),
            Form.Skills.Split('\n')
        );

        var candidateId = await _mediator.Send(command);

        // var candidate = State.CreateCandidate(Form);
        Navigation.NavigateTo($"/candidates/{candidateId}");
    }
}
