{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379,password=yourpassword,defaultDatabase=0"
  },
  "Keycloak": {
    "Authority": "https://your-keycloak.com/auth/realms/your-realm",
    "ClientId": "your-client",
    "ClientSecret": "your-secret"
  },
  "ReverseProxy": {
    "Clusters": {
      "HRService": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:02:00"
          }
        },
        "HttpClient": {
          "MaxConnectionsPerServer": 100
        },
        "HttpRequest": {
          "ActivityTimeout": "00:10:00",
          "Version": "1.0",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:8080/"
          },
          "dest2": {
            "Address": "http://localhost:8081/"
          },
          "dest3": {
            "Address": "http://localhost:8082/"
          }
        },
        "Metadata": {
          "TransportFailureRateHealthPolicy.RateLimit": "0.5"
        }
      }
    },
    "Routes": {
      "BaseHrService": {
        "ClusterId": "HRService",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    }
  },
  "AllowedHosts": "*"
}
